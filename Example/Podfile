platform :ios, '15.0'
use_frameworks!

target 'GameBallSDK_Example' do
  pod 'Gameball', :path => '../'
  pod 'FirebaseMessaging'
  
  target 'GameBallSDK_Tests' do
    inherit! :search_paths

    
  end
end

# Raise every pod to the app's minimum, so older pods that declare a lower
# deployment target build with current Xcode.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
